@using System.Drawing
@using PDFtoImage
@using UglyToad.PdfPig
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="pdf-stage">
    @if (_error is not null) { <MudAlert role="alert" Severity="Severity.Error">@_error</MudAlert> }
    <div class="PdfHighlighter" @ref="_element" aria-label="PDFプレビュー">
        <div class="pdfViewer">
            @foreach (var page in Enumerable.Range(1, _sizes.Count))
            {
                var width = PageWidth(page);
                var size = _sizes[page - 1];
                <div class="page" data-page-number="@(page)" @key="page"
                     style="@FormattableString.Invariant($"width:{width:0.###}px;aspect-ratio:{size.Width}/{size.Height}")">
                    @if (_images.TryGetValue(page, out var image))
                    {
                        <img src="@image.Url" alt="" class="pdf-page-image" draggable="false" />
                        <div class="textLayer" aria-label="@(page + "ページの本文")">
                            @foreach (var run in image.Text)
                            {
                                <span class="pdf-text-run" data-run-width="@F(run.WidthInEm)"
                                      style="@RunStyle(run)">@run.Text</span>
                            }
                        </div>
                    }
                    @if (RectangleMode)
                    {
                        <div class="pdf-drag-surface"
                             @onpointerdown="@(e => StartDrag(e, page))"
                             @onpointermove="@(e => MoveDrag(e, page))"
                             @onpointerup="@(e => EndDrag(e, page))"
                             @onpointercancel="@(() => _drag = null)"></div>
                    }
                    @foreach (var item in Highlights.Where(item => item.PageNumber == page))
                    {
                        <button type="button" @key="item.Id"
                                class="highlight-rectangle @(item.Id == SelectedId ? "highlight-rectangle--selected" : "")"
                                style="@RectangleStyle(item.Rectangle)"
                                aria-label="@($"{page}ページのハイライト：{(string.IsNullOrEmpty(item.Description) ? "説明なし" : item.Description)}")"
                                @onclick="() => HighlightSelected.InvokeAsync(item)"></button>
                    }
                    @if (Preview is { Rectangle: { } candidate } && Preview.PageNumber == page)
                    {
                        <div class="highlight-rectangle highlight-rectangle--proofreading" style="@RectangleStyle(candidate)"></div>
                    }
                    @if (Draft is { } draft && draft.Page == page)
                    {
                        <div class="highlight-rectangle highlight-rectangle--draft" style="@RectangleStyle(draft.Rectangle)"></div>
                    }
                    @if (_drag is { } drag && drag.Page == page)
                    {
                        <div class="highlight-rectangle highlight-rectangle--draft" style="@RectangleStyle(drag.Rectangle)"></div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public byte[] Bytes { get; set; } = [];
    [Parameter] public IReadOnlyList<Highlight> Highlights { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public PdfCandidate? Preview { get; set; }
    [Parameter] public (int Page, PageRectangle Rectangle)? Draft { get; set; }
    [Parameter] public bool RectangleMode { get; set; }
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public EventCallback<(int Page, PageRectangle Rectangle)> RectangleCompleted { get; set; }
    [Parameter] public EventCallback<Highlight> HighlightSelected { get; set; }

    public string ZoomLabel => _zoom is { } value ? $"{Math.Round(value * 100)}%" : "ページ幅";

    private record RenderedPage(int RasterWidth, string Url, IReadOnlyList<TextRun> Text);
    private record Drag(int Page, double X, double Y, double ToX, double ToY)
    {
        public PageRectangle Rectangle => new(Math.Min(X, ToX), Math.Min(Y, ToY), Math.Max(X, ToX), Math.Max(Y, ToY));
    }

    private readonly Dictionary<int, RenderedPage> _images = [];
    private IList<SizeF> _sizes = [];
    private PdfDocument? _textDocument;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewport;
    private DotNetObjectReference<PdfCanvas>? _callback;
    private double _viewportWidth = 850;
    private double _pixelRatio = 1;
    private double? _zoom;
    private int _current = 1;
    private int[] _visible = [];
    private int _renderVersion;
    private Drag? _drag;
    private bool _fitText;
    private bool _disposed;
    private string? _error;

    protected override void OnInitialized()
    {
        try
        {
            _sizes = Conversion.GetPageSizes(Bytes);
            _textDocument = PdfDocument.Open(Bytes);
        }
        catch (Exception error)
        {
            _error = $"PDFを開けませんでした。{error.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _sizes.Count > 0)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/viewers.js");
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }
            _callback = DotNetObjectReference.Create(this);
            _viewport = await _module.InvokeAsync<IJSObjectReference>("observeViewport", _element, _callback);
        }
        if (_fitText && _module is not null && !_disposed)
        {
            _fitText = false;
            await _module.InvokeVoidAsync("fitTextLayer", _element);
        }
    }

    [JSInvokable]
    public async Task ViewportChanged(double width, double pixelRatio, int current, int[] visible)
    {
        if (_disposed) return;
        _viewportWidth = width;
        _pixelRatio = pixelRatio;
        _visible = visible;
        _current = current;
        await CurrentPageChanged.InvokeAsync(current);
        await RefreshImages();
    }

    public async Task Zoom(int direction)
    {
        if (_sizes.Count == 0) return;
        var scale = _zoom ?? Math.Max(120, _viewportWidth - 24) / (ReferenceWidth * 4 / 3);
        var units = direction > 0 ? Math.Floor(scale * 4 + 0.001) : Math.Ceiling(scale * 4 - 0.001);
        _zoom = Math.Clamp((units + direction) / 4, 0.25, 4);
        await RefreshImages();
    }

    public async Task FitWidth()
    {
        _zoom = null;
        await RefreshImages();
    }

    public async Task Focus(int page, PageRectangle rectangle)
    {
        if (_module is not null && !_disposed)
            await _module.InvokeVoidAsync("focusPdfRegion", _element, page, rectangle.Left, rectangle.Top);
    }

    private double ReferenceWidth => _sizes.Count == 0 ? 612 : _sizes[0].Width;
    private double PageWidth(int page)
    {
        var reference = _zoom is { } scale ? ReferenceWidth * 4 / 3 * scale : Math.Max(120, _viewportWidth - 24);
        return reference * _sizes[page - 1].Width / ReferenceWidth;
    }

    private int RasterWidth(int page)
    {
        var size = _sizes[page - 1];
        var maxByHeight = 4096d * size.Width / size.Height;
        return (int)Math.Max(1, Math.Min(Math.Ceiling(PageWidth(page) * _pixelRatio), Math.Min(4096, maxByHeight)));
    }

    private async Task RefreshImages()
    {
        var module = _module;
        if (_disposed || module is null) return;
        var version = ++_renderVersion;
        var requested = _visible.OrderBy(page => Math.Abs(page - _current)).Take(8).ToArray();
        var expired = _images.Keys.Where(page => !requested.Contains(page)).ToArray();
        foreach (var page in expired)
        {
            var previous = _images[page];
            _images.Remove(page);
            await module.InvokeVoidAsync("releasePageUrl", previous.Url);
        }
        await InvokeAsync(StateHasChanged);

        foreach (var page in requested)
        {
            if (_disposed || version != _renderVersion) break;
            var width = RasterWidth(page);
            _images.TryGetValue(page, out var previous);
            if (previous?.RasterWidth == width) continue;
            try
            {
                await Task.Delay(1);
                if (_disposed || version != _renderVersion) break;
                var size = _sizes[page - 1];
                using var png = new MemoryStream();
                Conversion.SavePng(png, Bytes, page: page - 1, options: new RenderOptions(
                    Width: width, Height: Math.Max(1, (int)Math.Round(width * size.Height / size.Width))));
                var text = previous?.Text ?? (_textDocument is null ? [] : PdfTextLayer.Create(_textDocument.GetPage(page)));
                var url = await module.InvokeAsync<string>("createPageUrl", png.ToArray());
                if (_disposed || version != _renderVersion)
                {
                    await module.InvokeVoidAsync("releasePageUrl", url);
                    break;
                }
                _images[page] = new RenderedPage(width, url, text);
                if (previous is not null) await module.InvokeVoidAsync("releasePageUrl", previous.Url);
                _fitText = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception error) when (!_disposed)
            {
                _error = $"ページ {page} を描画できませんでした。{error.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartDrag(PointerEventArgs e, int page)
    {
        if (e.Button != 0) return;
        var (x, y) = Point(e, page);
        _drag = new(page, x, y, x, y);
    }

    private void MoveDrag(PointerEventArgs e, int page)
    {
        if (_drag is not { } drag || drag.Page != page) return;
        var (x, y) = Point(e, page);
        _drag = drag with { ToX = x, ToY = y };
    }

    private async Task EndDrag(PointerEventArgs e, int page)
    {
        MoveDrag(e, page);
        var drag = _drag;
        _drag = null;
        if (drag is null || drag.Page != page) return;
        var rectangle = drag.Rectangle;
        if ((rectangle.Right - rectangle.Left) * PageWidth(page) >= 4 &&
            (rectangle.Bottom - rectangle.Top) * PageHeight(page) >= 4)
            await RectangleCompleted.InvokeAsync((page, rectangle));
    }

    private double PageHeight(int page) => PageWidth(page) * _sizes[page - 1].Height / _sizes[page - 1].Width;
    private (double X, double Y) Point(PointerEventArgs e, int page) =>
        (Math.Clamp(e.OffsetX / PageWidth(page), 0, 1), Math.Clamp(e.OffsetY / PageHeight(page), 0, 1));

    private static string F(double value) => value.ToString("G", System.Globalization.CultureInfo.InvariantCulture);
    private static string RectangleStyle(PageRectangle box) => FormattableString.Invariant(
        $"left:{box.Left * 100}%;top:{box.Top * 100}%;width:{(box.Right - box.Left) * 100}%;height:{(box.Bottom - box.Top) * 100}%");
    private static string RunStyle(TextRun run) => FormattableString.Invariant(
        $"left:{run.Left * 100}%;top:{run.Top * 100}%;font-size:{run.FontSizeInPageWidths * 100}cqw;--run-angle:{run.Rotation}deg");

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _textDocument?.Dispose();
        if (_module is not null)
        {
            if (_viewport is not null)
            {
                await _viewport.InvokeVoidAsync("disconnect");
                await _viewport.DisposeAsync();
            }
            foreach (var image in _images.Values)
                await _module.InvokeVoidAsync("releasePageUrl", image.Url);
            await _module.DisposeAsync();
        }
        _callback?.Dispose();
    }
}
