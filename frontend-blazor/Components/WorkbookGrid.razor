@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="workbook-grid-scroll" aria-label="Excelプレビュー"><div @ref="_host"></div></div>

@code {
    [Parameter, EditorRequired] public WorksheetPreview Sheet { get; set; } = default!;
    [Parameter] public CellFinding? Selected { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _grid;
    private WorksheetPreview? _mounted;
    private CellFinding? _focused;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/viewers.js");
        if (_disposed || _module is null) return;

        if (!ReferenceEquals(Sheet, _mounted))
        {
            await ReleaseGrid();
            _mounted = Sheet;
            _focused = null;
            _grid = await _module.InvokeAsync<IJSObjectReference>("mountSheet", _host, new
            {
                Sheet.ColumnWidths, Sheet.RowCount, Sheet.Cells,
                Merges = Sheet.Merges.Select(merge => new
                {
                    Address = CellFinding.CellAddress(merge.Row, merge.Column),
                    merge.ColumnSpan, merge.RowSpan
                }).ToArray()
            });
        }

        if (!ReferenceEquals(Selected, _focused))
        {
            _focused = Selected;
            var current = Selected?.SheetNumber == Sheet.Info.Number ? Selected : null;
            if (_grid is not null) await _grid.InvokeVoidAsync("focus", current?.Row, current?.Column);
        }
    }

    private async ValueTask ReleaseGrid()
    {
        if (_grid is null) return;
        await _grid.InvokeVoidAsync("dispose");
        await _grid.DisposeAsync();
        _grid = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await ReleaseGrid();
        if (_module is not null) await _module.DisposeAsync();
    }
}
